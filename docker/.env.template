# ========================================================================
# Docker Compose Environment Variables Template
# ========================================================================
# Copy this file to .env and customize for your environment

# Project Configuration
COMPOSE_PROJECT_NAME=example_name
EXAMPLE_NAME=example_name

# MySQL Configuration
MYSQL_VERSION=8.0
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=example_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_PORT=3306
MYSQL_GENERAL_LOG=0

# MySQL 8.1 (optional)
MYSQL81_PORT=3307

# Database Management Tools
PHPMYADMIN_PORT=8080
ADMINER_PORT=8081
PMA_HOST=mysql8
ADMINER_HOST=mysql8

# Data Generator Configuration
GENERATOR_MODE=test
GENERATOR_SEED=42
GENERATOR_SCALE=small
GENERATOR_DB_HOST=mysql8
PYTHON_VERSION=3.10

# Redis Cache
REDIS_PORT=6379

# Memcached
MEMCACHED_PORT=11211

# PostgreSQL (for migration testing)
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=example_db

# MongoDB (for migration testing)
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=mongo
MONGO_DB=example_db

# Migration Configuration
MIGRATION_TARGET=postgres
TARGET_HOST=postgres
TARGET_PORT=5432
TARGET_DB=example_db
TARGET_USER=postgres
TARGET_PASS=postgres

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
MYSQL_EXPORTER_PORT=9104

# Network Configuration
NETWORK_SUBNET=172.20.0.0/16