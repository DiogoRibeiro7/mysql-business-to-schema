{
  "name": "mysql-business-schema",
  "version": "1.0.0",
  "description": "Node.js SDK for MySQL Business-to-Schema system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run clean && npm run build && npm run test",
    "docs": "typedoc --out docs src"
  },
  "keywords": [
    "mysql",
    "database",
    "schema",
    "migration",
    "sdk",
    "client",
    "api"
  ],
  "author": "MySQL Business Schema Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/mysql-business-to-schema.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/mysql-business-to-schema/issues"
  },
  "homepage": "https://github.com/yourusername/mysql-business-to-schema#readme",
  "dependencies": {
    "axios": "^1.6.2",
    "ws": "^8.14.2",
    "mysql2": "^3.6.5",
    "faker": "^5.5.3",
    "commander": "^11.1.0",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "table": "^6.8.1",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.3",
    "@types/ws": "^8.5.10",
    "@types/jest": "^29.5.10",
    "@types/faker": "^5.5.9",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typedoc": "^0.25.4",
    "typescript": "^5.3.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "bin": {
    "mysql-schema": "./dist/cli.js"
  }
}